# SafeRoute Guardian - Public Frontend Firebase Configuration Template
# IMPORTANT: Copy this file to .env.local and replace with your real Firebase Project credentials.
# These values are public client identifiers and are protected by Firebase Auth & Firestore Security Rules.
# NEVER place private service account keys, database passwords, or SMS provider API keys in this file.

VITE_FIREBASE_API_KEY=your_public_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# MapTiler / MapLibre GL JS Configuration
# Get a FREE key at: https://cloud.maptiler.com (free tier: 100k tile requests/month)
# SECURITY: Never hardcode or commit this key. Set it in Vercel Environment Variables.
# Restrict in MapTiler Cloud Console: Allowed HTTP Origins → add localhost + your Vercel domain.
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Optional: Set to 'true' to force demo simulation mode even if credentials exist
VITE_USE_MOCK_AUTH=false
