rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SafeRoute Guardian - Production-Hardened Security Rules (v2.0)
    // Principle of Least Privilege: Default Deny, Role-Based Access Control (RBAC),
    // Immutable Audit Trail, Consent-Based Family Linking, and Multi-Tenant Isolation.
    // =========================================================================

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verify Organization Membership
    function isOrgMember(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
      );
    }

    // Verify Organization Administrator
    function isOrgAdmin(orgId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active') ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid)
      );
    }

    // Verify Organization Staff Assignment to Traveler
    function isAssignedStaff(travelerData) {
      return isAuthenticated() && (
        travelerData.assignedStaffIds != null &&
        request.auth.uid in travelerData.assignedStaffIds
      );
    }

    // Verify Verified Linked Parent
    function isLinkedParent(travelerData) {
      return isAuthenticated() && (
        travelerData.linkedParentIds != null &&
        request.auth.uid in travelerData.linkedParentIds
      );
    }

    // -------------------------------------------------------------------------
    // 1. Users Collection
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // User can read only their own profile
      allow read: if isUser(userId);

      // User profile creation upon initial signup
      allow create: if isUser(userId) &&
        request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt']) &&
        // Protect role escalation: primaryRole & internal permissions must match initial safe defaults
        (!request.resource.data.keys().hasAny(['internalPermissions', 'customClaims']));

      // User profile updates: Users can edit display name, emergency contacts, but NOT role/permissions directly
      allow update: if isUser(userId) &&
        // Prevent users from tampering with role, organization membership, or permission claims
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'primaryRole', 'orgPermission', 'organizationIds', 'internalPermissions', 'customClaims', 'isSuperAdmin'
        ]);

      allow delete: if false; // User profiles cannot be deleted without cascade cleanup via Cloud Function
    }

    // -------------------------------------------------------------------------
    // 2. Organizations Collection & Members Subcollection
    // -------------------------------------------------------------------------
    match /organizations/{orgId} {
      // Active organization members can read organization metadata
      allow read: if isOrgMember(orgId);

      // Only Cloud Functions or Admin SDK create organizations, or authenticated users setting themselves as owner
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      // Only verified Organization Admins can update organization profile/settings
      allow update: if isOrgAdmin(orgId) &&
        // Owner ID cannot be changed directly
        request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Organization Members Subcollection
      match /members/{memberUid} {
        // Members within the organization can view the roster
        allow read: if isOrgMember(orgId);

        // Member additions, removals, and role changes must be performed by Org Admins only
        allow create, update, delete: if isOrgAdmin(orgId);
      }
    }

    // -------------------------------------------------------------------------
    // 3. Travelers Collection
    // -------------------------------------------------------------------------
    match /travelers/{travelerId} {
      // Read access: Traveler Owner, Verified Linked Parent, Assigned Staff, or Org Admin
      allow read: if isAuthenticated() && (
        resource.data.ownerUserId == request.auth.uid ||
        isLinkedParent(resource.data) ||
        (resource.data.organizationId != null && isOrgAdmin(resource.data.organizationId)) ||
        isAssignedStaff(resource.data)
      );

      // Create: Traveler creating personal profile, verified linked parent, or Org Admin
      allow create: if isAuthenticated() && (
        request.resource.data.ownerUserId == request.auth.uid ||
        (request.resource.data.organizationId != null && isOrgAdmin(request.resource.data.organizationId))
      );

      // Update: Owner, Verified Linked Parent, or Org Admin
      allow update: if isAuthenticated() && (
        resource.data.ownerUserId == request.auth.uid ||
        isLinkedParent(resource.data) ||
        (resource.data.organizationId != null && isOrgAdmin(resource.data.organizationId))
      );

      allow delete: if isAuthenticated() && (
        resource.data.ownerUserId == request.auth.uid ||
        (resource.data.organizationId != null && isOrgAdmin(resource.data.organizationId))
      );
    }

    // -------------------------------------------------------------------------
    // 4. Routes & Geofence Corridors Collection
    // -------------------------------------------------------------------------
    match /routes/{routeId} {
      // Personal route: readable by traveler owner or linked parent
      // Organization route: readable by active organization members
      allow read: if isAuthenticated() && (
        (resource.data.ownerType == 'personal' && (
          resource.data.travelerId == request.auth.uid ||
          (resource.data.allowedViewerIds != null && request.auth.uid in resource.data.allowedViewerIds)
        )) ||
        (resource.data.ownerType == 'organization' && isOrgMember(resource.data.organizationId))
      );

      // Create: Personal route owner or Organization Admin
      allow create: if isAuthenticated() && (
        (request.resource.data.ownerType == 'personal' && request.resource.data.travelerId == request.auth.uid) ||
        (request.resource.data.ownerType == 'organization' && isOrgAdmin(request.resource.data.organizationId))
      );

      // Update/Delete: Personal route owner or Organization Admin
      allow update, delete: if isAuthenticated() && (
        (resource.data.ownerType == 'personal' && resource.data.travelerId == request.auth.uid) ||
        (resource.data.ownerType == 'organization' && isOrgAdmin(resource.data.organizationId))
      );
    }

    // -------------------------------------------------------------------------
    // 5. Alerts & Incident Logs Collection
    // -------------------------------------------------------------------------
    match /alerts/{alertId} {
      // Read access: Traveler, Linked Parent, Assigned Staff, or Org Admin
      allow read: if isAuthenticated() && (
        (resource.data.allowedViewerIds != null && request.auth.uid in resource.data.allowedViewerIds) ||
        (resource.data.organizationId != null && isOrgMember(resource.data.organizationId))
      );

      // Create: Authenticated travelers creating SOS/checkin or system triggers
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        (request.resource.data.allowedViewerIds != null && request.auth.uid in request.resource.data.allowedViewerIds)
      );

      // Update: Org Staff, Admin, or Parent resolving/acknowledging an alert
      allow update: if isAuthenticated() && (
        (resource.data.organizationId != null && isOrgMember(resource.data.organizationId)) ||
        (resource.data.allowedViewerIds != null && request.auth.uid in resource.data.allowedViewerIds)
      ) &&
      // Evidence immutability: Original alert type, timestamp, traveler ID, and trigger data cannot be modified
      request.resource.data.type == resource.data.type &&
      request.resource.data.travelerId == resource.data.travelerId &&
      request.resource.data.createdAt == resource.data.createdAt;

      // Audit logs are append-only; client deletion is strictly denied
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 6. Journeys & Live Telemetry Collection
    // -------------------------------------------------------------------------
    match /journeys/{journeyId} {
      allow read: if isAuthenticated() && (
        resource.data.travelerId == request.auth.uid ||
        (resource.data.allowedViewerIds != null && request.auth.uid in resource.data.allowedViewerIds) ||
        (resource.data.organizationId != null && isOrgMember(resource.data.organizationId))
      );

      allow create, update: if isAuthenticated() && (
        request.resource.data.travelerId == request.auth.uid ||
        (request.resource.data.organizationId != null && isOrgAdmin(request.resource.data.organizationId))
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 7. Dependent Invitations & Linking Tokens
    // -------------------------------------------------------------------------
    match /dependentInvitations/{inviteId} {
      // Only the parent or child creator can read the pending invite token
      allow read: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.travelerId == request.auth.uid
      );
      // Written and redeemed via Cloud Functions
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // 8. Organization Invitations
    // -------------------------------------------------------------------------
    match /invitations/{inviteId} {
      allow read: if isAuthenticated() && (
        (resource.data.organizationId != null && isOrgAdmin(resource.data.organizationId)) ||
        resource.data.email == request.auth.token.email
      );
      // Invitations are created and verified via Cloud Functions / Admin SDK only
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Default Deny All Other Collections
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
